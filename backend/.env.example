APP_NAME=TranscriptsKE
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/transcriptske
# Generate a random secret; see README. Do not use this placeholder outside development.
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
INVITATION_EXPIRE_MINUTES=1440

# Local emails are private .eml files in backend/.mailbox; no network delivery.
MAIL_BACKEND=file
MAIL_FROM=no-reply@transcriptske.example
# Production requires smtp with STARTTLS and a real sender/provider.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
