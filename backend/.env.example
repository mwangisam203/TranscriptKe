APP_NAME=TranscriptsKE
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/transcriptske
# Generate a random secret; see README. Do not use this placeholder outside development.
SECRET_KEY=change-this-secret-key
# Optional for admission lookup; required to enable ID/passport matching.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IDENTITY_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
INVITATION_EXPIRE_MINUTES=1440

# Local emails are private .eml files in backend/.mailbox; no network delivery.
MAIL_BACKEND=file
MAIL_FROM=no-reply@transcriptske.example
# Production requires smtp with STARTTLS and a real sender/provider.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Order attachments: UTF-8 TXT works locally. PDF/PNG/JPEG require ClamAV.
# Install clamscan and maintain its signature database before enabling.
ATTACHMENT_SCANNER=disabled
CLAMAV_COMMAND=clamscan

# Milestone 5: enable only after configuring the authorized pilot merchant.
PAYMENT_COLLECTION_POLICY=before_review
PAYMENTS_ENABLED=false
PAYMENT_MODE=test
# TranscriptsKE collects for schools enabled in the admin billing settings.
PAYMENT_ROUTING_MODE=platform
# Legacy single-school testing only: PAYMENT_ROUTING_MODE=pilot
# PAYMENT_INSTITUTION_ID=1
PAYMENT_PUBLIC_URL=http://127.0.0.1:8000
# Card checkout: a publishable key enables secure embedded fields.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Daraja M-Pesa Express, PayBill credentials. Requires a public HTTPS origin.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# Optional reversal credentials, required for approving M-Pesa refunds.
# MPESA_INITIATOR=
# MPESA_SECURITY_CREDENTIAL=

# Milestone 6: institution-prepared PDFs and recipient delivery.
# Enable only after configuring the scanner; demo mode uses sample PDFs and test payments.
ISSUANCE_ENABLED=false
ISSUANCE_MODE=demo
ISSUANCE_PUBLIC_URL=http://127.0.0.1:8000
DELIVERY_EXPIRE_DAYS=7
# Live issuance requires HTTPS, ClamAV and SMTP with STARTTLS.

# Milestone 7: manager exception queues and worker freshness (minutes).
OPERATIONS_PAYMENT_PENDING_MINUTES=30
OPERATIONS_NOTIFICATION_PENDING_MINUTES=15
OPERATIONS_WORKER_STALE_MINUTES=15
